{
	"name": "hoppercode",
	"private": true,
	"license": "MIT",
	"version": "0.3.1",
	"packageManager": "pnpm@11.5.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"type": "module",
	"scripts": {
		"dev": "node scripts/ui-mock-host.mjs",
		"build": "node scripts/build.mjs",
		"yak": "node scripts/yak.mjs",
		"version:bump": "node scripts/version-bump.mjs",
		"release": "node scripts/release.mjs",
		"build:install": "node scripts/install-rhino.mjs --yes",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
		"check": "pnpm typecheck && pnpm test",
		"check:native": "dotnet test dotnet/Hopper.Core.Tests/Hopper.Core.Tests.csproj --configuration Release && pnpm exec tsx scripts/cross-language-rpc-smoke.ts"
	},
	"devDependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"@radix-ui/react-collapsible": "^1.2.1",
